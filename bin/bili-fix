#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
bili-fix —— 整理从哔哩哔哩下载的视频

对单个视频依次做：
  1. 从文件名提取 BV 号
  2. 查 B 站接口拿标题、封面
  3. 下载封面
  4. 用 ffmpeg 把封面嵌进视频（不转码，只 remux）
  5. 把文件名改成标题（括号统一成中括号，去掉非法字符）
  6. 把 BV 号和标题追加到记录文件，方便以后重新下载

每一步失败都不影响后面的步骤，最后返回非 0 表示有环节失败。

用法：
    bili-fix <视频路径>
    bili-fix <视频路径> --no-cover
    bili-fix <视频路径> --dry-run
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request
from pathlib import Path

UA = ("Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
      "AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36")
REFERER = "https://www.bilibili.com"
API = "https://api.bilibili.com/x/web-interface/view?bvid={}"

BV_RE = re.compile(r"BV[0-9A-Za-z]{10}", re.IGNORECASE)

STATE_DIR = Path(os.environ.get(
    "FILE_TIDY_STATE",
    str(Path.home() / ".local" / "state" / "file_tidy"),
))
DEFAULT_RECORD = STATE_DIR / "bili-downloads.tsv"

# 文件名里不能出现的字符
ILLEGAL = re.compile(r'[\\/:*?"<>|\r\n\t]')


# ============================================================
# 纯函数
# ============================================================


def extract_bvid(name: str) -> str | None:
    """从文件名里提取 BV 号，前缀统一成大写 BV"""
    m = BV_RE.search(name)
    if not m:
        return None
    s = m.group(0)
    return "BV" + s[2:]


def clean_title(title: str) -> str:
    """标题清洗：全角括号转中括号，去掉文件名非法字符"""
    t = title.replace("（", "[").replace("）", "]")
    t = ILLEGAL.sub("_", t)
    t = t.strip(" .")
    return t or "untitled"


# ============================================================
# 网络
# ============================================================


def _get(url: str, timeout: int = 10, binary: bool = False):
    req = urllib.request.Request(url, headers={
        "User-Agent": UA,
        "Referer": REFERER,
    })
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read() if binary else json.loads(r.read().decode("utf-8"))


def fetch_meta(bvid: str, timeout: int = 10) -> dict:
    """查视频信息，返回标题、封面地址等"""
    data = _get(API.format(bvid), timeout=timeout)
    if data.get("code") != 0:
        raise RuntimeError(f"接口返回 code={data.get('code')} {data.get('message')}")
    d = data["data"]
    return {
        "bvid": d.get("bvid", bvid),
        "title": d.get("title", ""),
        "cover": d.get("pic", ""),
        "owner": (d.get("owner") or {}).get("name", ""),
        "pubdate": d.get("pubdate", 0),
    }


def download_cover(url: str, dest: Path, timeout: int = 15) -> None:
    """下载封面；B 站有防盗链，必须带 Referer"""
    raw = _get(url, timeout=timeout, binary=True)
    if not raw:
        raise RuntimeError("封面内容为空")
    dest.write_bytes(raw)


# ============================================================
# 视频处理
# ============================================================


def has_cover(video: Path) -> bool:
    """用 ffprobe 判断视频里是否已经有封面轨"""
    if not shutil.which("ffprobe"):
        return False
    try:
        out = subprocess.run(
            ["ffprobe", "-v", "quiet", "-print_format", "json",
             "-show_streams", str(video)],
            capture_output=True, timeout=30, check=False,
        )
        info = json.loads(out.stdout.decode("utf-8", "replace") or "{}")
    except (OSError, subprocess.SubprocessError, ValueError):
        return False
    for s in info.get("streams", []):
        if (s.get("disposition") or {}).get("attached_pic") == 1:
            return True
    return False


def embed_cover(video: Path, cover: Path) -> None:
    """把封面作为 attached_pic 流嵌入，不重新编码"""
    if not shutil.which("ffmpeg"):
        raise RuntimeError("找不到 ffmpeg，请先 pkg install ffmpeg")

    tmp = video.with_name(video.stem + ".cover-tmp" + video.suffix)
    cmd = [
        "ffmpeg", "-y", "-loglevel", "error",
        "-i", str(video),
        "-i", str(cover),
        "-map", "0", "-map", "1",
        "-c", "copy",
        "-disposition:v:1", "attached_pic",
        str(tmp),
    ]
    try:
        subprocess.run(cmd, check=True, timeout=600,
                       stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
        os.replace(tmp, video)
    finally:
        if tmp.exists():
            tmp.unlink(missing_ok=True)


# ============================================================
# 记录
# ============================================================


def append_record(path: Path, meta: dict, video: Path) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    new = not path.exists()
    with path.open("a", encoding="utf-8") as fh:
        if new:
            fh.write("bv\t日期\tUP主\t标题\t文件\n")
        fh.write("\t".join([
            meta["bvid"],
            str(meta.get("pubdate", "")),
            meta.get("owner", ""),
            meta.get("title", ""),
            video.name,
        ]) + "\n")


# ============================================================
# 主流程
# ============================================================


def process(video: Path, *, do_cover: bool, do_rename: bool,
            record: Path | None, dry_run: bool, verbose: bool) -> int:
    """返回 0 全成功，1 有环节失败"""

    def say(msg: str) -> None:
        if verbose:
            print(msg, file=sys.stderr)

    bvid = extract_bvid(video.name)
    if not bvid:
        say(f"跳过（没有 BV 号）：{video.name}")
        return 0

    try:
        meta = fetch_meta(bvid)
    except (urllib.error.URLError, RuntimeError, TimeoutError, ValueError) as exc:
        print(f"[失败] 查询 {bvid}：{exc}", file=sys.stderr)
        return 1

    say(f"{bvid} → {meta['title']}")

    failed = 0

    # 1. 封面
    if do_cover and not has_cover(video):
        with tempfile.TemporaryDirectory() as td:
            cover = Path(td) / "cover.jpg"
            try:
                download_cover(meta["cover"], cover)
                if dry_run:
                    say(f"[dry-run] 会写入封面：{cover}")
                else:
                    embed_cover(video, cover)
                    say("封面已写入")
            except (urllib.error.URLError, RuntimeError, OSError) as exc:
                print(f"[失败] 写入封面 {video.name}：{exc}", file=sys.stderr)
                failed += 1

    # 2. 改名（只在文件名还带 BV 前缀时做）
    if do_rename and video.name.startswith(bvid):
        new_name = clean_title(meta["title"]) + video.suffix
        if new_name == video.name:
            say("文件名已经是标题，跳过")
        else:
            target = video.with_name(new_name)
            if target.exists():
                say(f"目标已存在，跳过改名：{new_name}")
            elif dry_run:
                say(f"[dry-run] 会改名为：{new_name}")
            else:
                try:
                    video.rename(target)
                    video = target
                    say(f"已改名：{new_name}")
                except OSError as exc:
                    print(f"[失败] 改名 {video.name}：{exc}", file=sys.stderr)
                    failed += 1

    # 3. 记录
    if record and not dry_run:
        try:
            append_record(record, meta, video)
        except OSError as exc:
            print(f"[失败] 写记录：{exc}", file=sys.stderr)
            failed += 1

    return 1 if failed else 0


def main(argv: list[str] | None = None) -> int:
    try:
        sys.stdout.reconfigure(encoding="utf-8", errors="replace")
        sys.stderr.reconfigure(encoding="utf-8", errors="replace")
    except Exception:
        pass

    ap = argparse.ArgumentParser(description="整理 B 站下载的视频：改名 + 写封面 + 记录")
    ap.add_argument("video", help="视频文件路径")
    ap.add_argument("--no-cover", action="store_true", help="不写封面")
    ap.add_argument("--no-rename", action="store_true", help="不改文件名")
    ap.add_argument("--record", default=str(DEFAULT_RECORD),
                    help=f"记录文件，默认 {DEFAULT_RECORD}")
    ap.add_argument("--no-record", action="store_true", help="不写记录")
    ap.add_argument("--dry-run", "-n", action="store_true", help="只打印，不动文件")
    ap.add_argument("--verbose", "-v", action="store_true")
    args = ap.parse_args(argv)

    video = Path(args.video).expanduser()
    if not video.is_file():
        print(f"[错误] 找不到文件：{video}", file=sys.stderr)
        return 2

    record = None if args.no_record else Path(args.record).expanduser()

    return process(
        video,
        do_cover=not args.no_cover,
        do_rename=not args.no_rename,
        record=record,
        dry_run=args.dry_run,
        verbose=args.verbose,
    )


if __name__ == "__main__":
    sys.exit(main())
